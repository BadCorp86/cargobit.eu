// 13. SYSTEM SETTINGS
// ============================================

model SystemSetting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String    // JSON
  description String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([key])
}

// ============================================
// 14. RISK SCORING SYSTEM
// ============================================

enum RiskEntityType {
  USER
  COMPANY
  TRANSACTION
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

model RiskScore {
  id            String          @id @default(cuid())
  entityType    RiskEntityType
  entityId      String
  
  score         Int             @default(0)    // 0-100
  riskLevel     RiskLevel       @default(GREEN)
  
  // Sub-scores (for combined scoring)
  userScore     Int?
  companyScore  Int?
  transactionScore Int?
  
  // Metadata
  factorsCount  Int             @default(0)
  lastEventAt   DateTime?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Relations
  events        RiskEvent[]
  history       RiskHistory[]
  
  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
  @@index([riskLevel])
  @@index([score])
}

model RiskEvent {
  id            String          @id @default(cuid())
  entityType    RiskEntityType
  entityId      String
  
  ruleId        String?         // Reference to RiskRule
  ruleName      String          // Rule identifier (e.g., "user_kyc_missing")
  ruleCategory  String          // USER, COMPANY, TRANSACTION
  
  weight        Int             // Score change (+ or -)
  metadata      String?         // JSON with details (IP, amount, GPS, etc.)
  
  // Context
  triggeredBy   String?         // User ID or system process
  relatedEntity String?         // Related transport/offer/wallet ID
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime        @default(now())
  
  // Relations
  riskScore     RiskScore?      @relation(fields: [riskScoreId], references: [id], onDelete: SetNull)
  riskScoreId   String?
  
  @@index([entityType])
  @@index([entityId])
  @@index([ruleName])
  @@index([createdAt])
}

model RiskRule {
  id            String          @id @default(cuid())
  name          String          @unique  // e.g., "user_kyc_missing"
  description   String?
  
  entityType    RiskEntityType
  category      String          // USER, COMPANY, TRANSACTION, BEHAVIOR, DOCUMENT
  
  // Condition as JSON
  condition     String          // JSON: { "field": "kyc_status", "equals": "missing" }
  
  weight        Int             // Score change (+ increases risk, - decreases risk)
  active        Boolean         @default(true)
  
  // Configuration
  priority      Int             @default(0)  // Higher priority = evaluated first
  maxTriggers   Int?            // Max times this rule can trigger per day/week
  
  // Metadata
  createdBy     String?
  lastModifiedBy String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([entityType])
  @@index([category])
  @@index([active])
}

model RiskHistory {
  id            String          @id @default(cuid())
  entityType    RiskEntityType
  entityId      String
  
  oldScore      Int
  newScore      Int
  scoreChange   Int             // newScore - oldScore
  
  oldLevel      RiskLevel
  newLevel      RiskLevel
  
  reason        String?         // Human-readable reason
  eventId       String?         // Reference to triggering RiskEvent
  
  createdAt     DateTime        @default(now())
  
  // Relations
  riskScore     RiskScore?      @relation(fields: [riskScoreId], references: [id], onDelete: SetNull)
  riskScoreId   String?
  
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

// ============================================
// 15. RISK THRESHOLDS CONFIGURATION
// ============================================

model RiskThreshold {
  id            String          @id @default(cuid())
  name          String          @unique  // "green", "yellow", "red"

  minValue      Int             // Inclusive
  maxValue      Int             // Inclusive

  // Actions
  allowAction   Boolean         @default(true)
  requireDelay  Boolean         @default(false)
  delayHours    Int?
  require2FA    Boolean         @default(false)
  requireGPS    Boolean         @default(false)
  createTicket  Boolean         @default(false)
  notifySupport Boolean         @default(false)

  // Mitigations as JSON
  mitigations   String?         // JSON array of mitigation actions

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([name])
}

// ============================================
// 16. PARTNER PORTAL SYSTEM
// ============================================

enum PartnerType {
  INSURANCE
  ADS
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BillingStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum AdSlotType {
  MARKETPLACE_SIDEBAR
  MARKETPLACE_BANNER
  LISTING_HIGHLIGHT
  CHECKOUT_UPSELL
  EMAIL_SPONSOR
}

enum CampaignPricingModel {
  CPC  // Cost per Click
  CPM  // Cost per Mille (1000 impressions)
  CPA  // Cost per Action
}

model Partner {
  id              String        @id @default(cuid())

  // Basic Info
  name            String        // Company name
  type            PartnerType   // insurance or ads
  contactEmail    String
  contactPhone    String?
  contactPerson   String?       // Name of contact person
  website         String?

  // Legal
  vatNumber       String?       @unique
  registrationNumber String?
  country         String?
  address         String?

  // Status
  status          PartnerStatus @default(PENDING)
  statusReason    String?       // Reason for rejection/suspension

  // Documents
  contractUrl     String?       // Signed contract PDF
  complianceDocs  String?       // JSON array of document URLs

  // Configuration
  webhookUrl      String?
  testMode        Boolean       @default(true)
  liveModeEnabled Boolean       @default(false)

  // Commission
  commissionRate  Float         @default(10.0)  // Partner's commission percentage

  // Limits
  rateLimitPerMin Int           @default(300)
  burstLimit      Int           @default(100)

  // Timestamps
  approvedAt      DateTime?
  approvedBy      String?       // Admin user ID
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  apiKeys         PartnerApiKey[]
  insuranceProducts InsuranceProduct[]
  insuranceReferralLeads InsuranceReferralLead[]
  adCampaigns     PartnerAdCampaign[]
  billings        PartnerBilling[]
  policies         InsurancePolicy[]
  insuranceReferralEvents InsuranceReferralEvent[]
  adStats          PartnerAdStat[]

  @@index([type])
  @@index([status])
  @@index([contactEmail])
}

model PartnerApiKey {
  id              String        @id @default(cuid())
  partnerId       String

  // Key Info
  name            String        // "Production Key", "Test Key"
  apiKey          String        @unique  // The actual API key (hashed in production)
  apiKeyPrefix    String        // First 8 chars for identification

  // Scopes
  scopes          String        // JSON array: ["insurance:read", "insurance:write", "ads:read", "ads:write", "billing:read"]

  // Status
  status          ApiKeyStatus  @default(ACTIVE)
  isTestKey       Boolean       @default(true)

  // Limits
  rateLimitPerMin Int?
  lastUsedAt      DateTime?

  // Timestamps
  createdAt       DateTime      @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedReason   String?

  // Relations
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([apiKey])
  @@index([status])
}

model InsuranceProduct {
  id              String        @id @default(cuid())
  partnerId       String

  // Product Info
  name            String        // "Standard Cargo", "Premium Cargo", "ADR Coverage"
  description     String?
  productCode     String?       // Internal product code

  // Coverage
  coverageEur     Float         // Maximum coverage in EUR
  deductibleEur   Float         @default(0)

  // Pricing
  basePremiumEur  Float         // Base premium in EUR
  premiumType     String        @default("fixed")  // fixed, percentage, per_kg

  // Risk Modifiers
  riskModifiers   String?       // JSON: { "yellow": 1.2, "red": 1.5 }
  routeModifiers  String?       // JSON for international routes
  cargoModifiers  String?       // JSON for cargo types

  // Coverage Options
  coversTheft     Boolean       @default(true)
  coversDelay     Boolean       @default(false)
  coversDamage    Boolean       @default(true)
  coversHazmat    Boolean       @default(false)

  // Additional Options (available add-ons)
  additionalOptions String?     // JSON array of available options

  // Status
  isActive        Boolean       @default(true)

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  policies         InsurancePolicy[]
  referralLeads    InsuranceReferralLead[]

  @@index([partnerId])
  @@index([isActive])
}

model InsuranceReferralLead {
  id                    String        @id @default(cuid())
  partnerId             String?
  productId             String?
  transportId           String?

  // Lead context
  requestedByUserId     String?
  requestedByRole       String        @default("SHIPPER") // SHIPPER, CARRIER, ADMIN
  source                String        @default("SHIPPER_CREATE") // SHIPPER_CREATE, CARRIER_ACCEPTANCE, ADMIN
  status                String        @default("LEAD_CREATED") // LEAD_CREATED, REDIRECTED, CONVERTED, DECLINED, EXPIRED

  // Provider snapshot for audit even if partner config changes later
  providerName          String
  productName           String
  referralUrl           String?
  externalReference     String?

  // Cargo and route snapshot
  cargoDescription      String?
  cargoValueEur         Float?
  weightKg              Float?
  pickupCity            String?
  pickupCountry         String?
  deliveryCity          String?
  deliveryCountry       String?

  // Quote snapshot
  premiumEstimateEur    Float
  coverageEstimateEur   Float
  deductibleEur         Float          @default(0)
  currency              String         @default("EUR")

  // CargoBit monetization as technical lead/referral
  commissionType        String         @default("PERCENT") // PERCENT, FIXED
  commissionRate        Float          @default(12.0)
  commissionEstimateEur Float
  commissionStatus      String         @default("PENDING") // PENDING, EARNED, INVOICED, PAID, VOID
  commissionInvoiceReference String?
  commissionSettledAt   DateTime?

  // Compliance
  consentAccepted       Boolean        @default(false)
  complianceNotice      String

  // Timestamps
  validUntil            DateTime
  redirectedAt          DateTime?
  convertedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  partner               Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  product               InsuranceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  events                InsuranceReferralEvent[]

  @@index([partnerId])
  @@index([productId])
  @@index([transportId])
  @@index([requestedByUserId])
  @@index([status])
  @@index([commissionStatus])
  @@index([createdAt])
}

model InsuranceReferralEvent {
  id                    String        @id @default(cuid())
  leadId                String
  partnerId             String?

  actorType             String        @default("SYSTEM") // SYSTEM, ADMIN, PARTNER, WEBHOOK
  actorId               String?
  eventType             String        // lead_created, lead_redirected, lead_converted, commission_paid
  oldStatus             String?
  newStatus             String?
  externalReference     String?
  premiumEur            Float?
  commissionEur         Float?
  metadata              String?
  createdAt             DateTime      @default(now())

  lead                  InsuranceReferralLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partner               Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([partnerId])
  @@index([eventType])
  @@index([createdAt])
}

model InsurancePolicy {
  id              String        @id @default(cuid())
  partnerId       String
  productId       String
  transportId     String?       // Link to transport

  // Policy Info
  policyNumber    String        @unique
  status          String        @default("active")  // active, cancelled, expired, claimed

  // Coverage
  coverageEur     Float
  premiumEur      Float
  deductibleEur   Float

  // Insured Party
  insuredUserId   String?
  insuredName     String
  insuredEmail    String

  // Risk Assessment
  riskLevel       String?       // green, yellow, red
  riskScore       Int?

  // Route Info
  pickupCountry   String?
  deliveryCountry String?
  transitCountries String?      // JSON array

  // Cargo Info
  cargoDescription String?
  cargoValueEur   Float?

  // Premium Details
  basePremium     Float
  riskSurcharge   Float         @default(0)
  totalPremium    Float

  // Commission
  partnerCommission Float

  // Dates
  validFrom       DateTime
  validUntil      DateTime
  cancelledAt     DateTime?

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product         InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model PartnerAdCampaign {
  id              String        @id @default(cuid())
  partnerId       String

  // Campaign Info
  name            String
  description     String?

  // Placement
  slot            AdSlotType    @default(MARKETPLACE_SIDEBAR)

  // Creative
  bannerUrl       String?
  bannerAlt       String?
  targetUrl       String
  callToAction    String?       // "Jetzt absichern", "Mehr erfahren"

  // Budget
  budgetEur       Float
  spentEur        Float         @default(0)
  currency        String        @default("EUR")

  // Pricing Model
  pricingModel    CampaignPricingModel @default(CPC)
  cpcEur          Float?        // Cost per click
  cpmEur          Float?        // Cost per 1000 impressions
  cpaEur          Float?        // Cost per action/conversion

  // Targeting
  targeting       String?       // JSON: { "riskLevels": ["yellow", "red"], "roles": ["shipper"], "countries": ["DE", "AT"] }
  languageTarget  String?       // JSON array of language codes

  // Schedule
  startDate       DateTime?
  endDate         DateTime?

  // Status
  status          CampaignStatus @default(DRAFT)

  // Stats (aggregated)
  totalImpressions Int          @default(0)
  totalClicks     Int           @default(0)
  totalConversions Int          @default(0)

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  dailyStats      PartnerAdStat[]

  @@index([partnerId])
  @@index([status])
  @@index([slot])
}

model PartnerAdStat {
  id              String        @id @default(cuid())
  partnerId       String
  campaignId      String

  // Date
  date            DateTime

  // Metrics
  impressions     Int           @default(0)
  clicks          Int           @default(0)
  conversions     Int           @default(0)

  // Costs
  costEur         Float         @default(0)

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  campaign        PartnerAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([partnerId])
  @@index([campaignId])
  @@index([date])
}

model PartnerBilling {
  id              String        @id @default(cuid())
  partnerId       String

  // Billing Info
  invoiceNumber   String        @unique
  type            PartnerType   // insurance or ads

  // Period
  periodMonth     Int           // 1-12
  periodYear      Int

  // Amounts
  grossAmountEur  Float
  commissionEur   Float         // CargoBit's commission
  netAmountEur    Float         // Partner receives this
  vatEur          Float?
  totalEur        Float

  // Status
  status          BillingStatus @default(OPEN)

  // Payment
  paidAt          DateTime?
  paymentMethod   String?
  paymentReference String?

  // Documents
  invoiceUrl      String?       // PDF URL

  // Details (JSON)
  lineItems       String?       // JSON array of billing line items

  // Timestamps
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([periodYear, periodMonth])
}

// ============================================
// 17. PAYOUTS - Admin Payout Management
// ============================================

enum PayoutStatus {
  PENDING       // Created, awaiting processing
  PROCESSING    // Stripe transfer initiated
  PAID          // Successfully completed
  FAILED        // Transfer failed
  CANCELLED     // Manually cancelled
}

model Payout {
  id                String        @id @default(cuid())
  userId            String

  // Amount
  amountCents       Int           // Amount in cents (100 = 1.00 EUR)
  currency          String        @default("EUR")

  // Status
  status            PayoutStatus  @default(PENDING)

  // Stripe Integration
  stripeTransferId  String?       // Stripe Transfer ID
  stripeAccountId   String?       // Destination Stripe account

  // Error Handling
  failureReason     String?
  retryCount        Int           @default(0)
  lastRetryAt       DateTime?

  // Idempotency
  idempotencyKey    String?       @unique

  // Payout Method
  payoutMethodId    String?       // Reference to PayoutMethod
  ibanLast4         String?       // Last 4 chars of IBAN for display

  // Risk Assessment
  riskScore         Int?
  riskLevel         String?       // green, yellow, red
  riskFactors       String?       // JSON array

  // Delay Mechanism (for yellow risk)
  delayedUntil      DateTime?
  delayReason       String?

  // Audit
  createdBy         String?       // Admin user ID who created
  processedBy       String?       // Admin user ID who processed
  processedAt       DateTime?

  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]
  attempts          PayoutAttempt[]
  events            PayoutEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

// ============================================
// 18. PAYOUT ATTEMPTS - Stripe Transfer Logs
// ============================================

model PayoutAttempt {
  id              String        @id @default(cuid())
  payoutId        String

  // Attempt Info
  attemptAt       DateTime      @default(now())
  status          String        // transfer_created, transfer_failed, retry_scheduled

  // Response Data
  stripeResponse  String?       // JSON: Stripe API response
  error           String?       // Error message if failed

  // Timestamps
  createdAt       DateTime      @default(now())

  // Relations
  payout          Payout        @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@index([attemptAt])
}

// ============================================
// 19. PAYOUT EVENTS - Webhook Event Log
// ============================================

model PayoutEvent {
  id              String        @id
  payoutId        String?

  // Event Info
  type            String        // transfer.paid, payout.failed, etc.
  payload         String?       // JSON: Full event payload

  // Processing Status
  processed       Boolean       @default(false)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?

  // Relations
  payout          Payout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([payoutId])
  @@index([processed])
  @@index([receivedAt])
}
