  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String?
  dataBefore  String?
  dataAfter   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Payment {
  id                       String        @id @default(cuid())
  jobId                    String?
  bidId                    String?
  shipperId                String
  transporterId            String?

  paymentIntentId          String        @unique
  chargeId                 String?       @unique
  stripeCustomerId         String?

  amountCents              Int
  currency                 String        @default("EUR")
  platformFeeCents         Int           @default(0)
  stripeFeeCents           Int           @default(0)
  transporterAmountCents   Int?
  refundedCents            Int           @default(0)
  refundedAmountCents      Int           @default(0)

  status                   PaymentStatus @default(PENDING)
  paymentType              PaymentType   @default(CARD)
  description              String?
  metadata                 String?
  failedReason             String?

  paidAt                   DateTime?
  succeededAt              DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  transport                Transport?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  shipper                  User          @relation("ShipperPayments", fields: [shipperId], references: [id], onDelete: Cascade)
  transporter              User?         @relation("TransporterPayments", fields: [transporterId], references: [id], onDelete: SetNull)
  refunds                  Refund[]
  auditEvents              PaymentAuditEvent[]
  walletTransactions       WalletTransaction[]

  @@index([jobId])
  @@index([shipperId])
  @@index([transporterId])
  @@index([paymentIntentId])
  @@index([chargeId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id                       String       @id @default(cuid())
  paymentId                String
  refundId                 String?      @unique
  stripeRefundId           String?      @unique

  amountCents              Int
  currency                 String       @default("EUR")
  shipperRefundCents       Int          @default(0)
  platformFeeRefundCents   Int          @default(0)
  transporterDebitCents    Int          @default(0)
  refundType               RefundType   @default(PARTIAL)

  reason                   String?
  status                   RefundStatus @default(PENDING)
  initiatedBy              String?
  processedAt              DateTime?
  stripeCreatedAt          DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  payment                  Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model PaymentAuditEvent {
  id          String         @id @default(cuid())
  paymentId   String
  eventType   String
  oldStatus   PaymentStatus?
  newStatus   PaymentStatus?
  adminId     String?
  metadata    String?
  createdAt   DateTime       @default(now())

  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventType])
  @@index([createdAt])
}

model Dispute {
  id                   String             @id @default(cuid())
  jobId                String
  createdById          String
  againstId            String?
  assignedToId         String?
  resolvedById         String?

  reason               String
  subject              String?
  description          String
  disputedAmountCents  Int?
  currency             String             @default("EUR")

  status               DisputeStatus      @default(OPEN)
  resolution           DisputeResolution?
  resolutionText       String?
  refundAmountCents    Int?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  resolvedAt           DateTime?

  createdBy            User               @relation("DisputesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  against              User?              @relation("DisputesAgainst", fields: [againstId], references: [id], onDelete: SetNull)
  messages             DisputeMessage[]
  attachments          DisputeAttachment[]
  auditEvents          DisputeAuditEvent[]

  @@index([jobId])
  @@index([createdById])
  @@index([againstId])
  @@index([assignedToId])
  @@index([resolvedById])
  @@index([status])
  @@index([createdAt])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  senderId    String
  senderType  String
  message     String
  attachments String?
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([senderId])
  @@index([createdAt])
}

model DisputeAttachment {
  id          String   @id @default(cuid())
  disputeId   String
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model DisputeAuditEvent {
  id          String         @id @default(cuid())
  disputeId   String
  eventType   String
  oldStatus   DisputeStatus?
  newStatus   DisputeStatus?
  adminId     String?
  metadata    String?
  createdAt   DateTime       @default(now())

  dispute     Dispute        @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([eventType])
  @@index([createdAt])
}

