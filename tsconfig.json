{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "tailwind.config.ts",
    "src/proxy.ts",
    "src/app/layout.tsx",
    "src/app/page.tsx",
    "src/app/billing/page.tsx",
    "src/app/carrier/wallet/page.tsx",
    "src/app/driver/earnings/page.tsx",
    "src/app/driver/mobile/page.tsx",
    "src/app/orders/**/*.tsx",
    "src/app/preview/page.tsx",
    "src/app/api/disputes/route.ts",
    "src/app/api/disputes/[id]/route.ts",
    "src/app/api/jobs/route.ts",
    "src/app/api/jobs/[id]/accept_bid/route.ts",
    "src/app/api/jobs/[id]/publish/route.ts",
    "src/app/api/orders/[id]/payout/bank-transfer/route.ts",
    "src/app/api/orders/[id]/payout/release/route.ts",
    "src/app/api/wallet/route.ts",
    "src/app/api/wallet/payout/route.ts",
    "src/app/api/wallet/payout-stripe/route.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "download/**/*.ts",
    "examples",
    "microservices",
    "mini-services",
    "scripts",
    "config-service",
    "wallet-payment",
    "reports",
    "__tests__",
    "tests",
    "src/**/__tests__",
    "src/audit/**",
    "src/dto/**",
    "src/payments/**",
    "src/reconciliation/**",
    "src/reports/**",
    "src/sdk/**",
    "src/wallet/**",
    "src/webhooks/**"
  ]
}
