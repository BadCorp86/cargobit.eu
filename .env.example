# CargoBit environment template
# Copy values into Vercel Project Settings > Environment Variables.
# Do not commit real secrets. Keep .env and .env.local private.

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://cargobit.eu
NEXT_PUBLIC_URL=https://cargobit.eu
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Local Postgres.app preview example:
# DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/cargobit_dev?schema=public
# Optional direct connection for providers like Neon/Supabase when pooling is enabled.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
ENCRYPTION_KEY=replace-with-long-random-secret
CRON_SECRET=replace-with-long-random-cron-secret

# Admin access
ADMIN_EMAIL=admin@cargobit.eu
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_JWT_SECRET=replace-with-long-random-jwt-secret
ADMIN_ROLE=ADMIN

# Stripe core
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
# Optional when you create separate webhook endpoints in Stripe.
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_replace_subscription
STRIPE_PAYOUT_WEBHOOK_SECRET=whsec_replace_payout
DEFAULT_STRIPE_ACCOUNT_ID=acct_replace

# Stripe Connect
# Optional if Connect onboarding is used.
STRIPE_CONNECT_CLIENT_ID=ca_replace

# Stripe Tax
# Set to true only after Stripe Tax is configured in the Stripe dashboard.
STRIPE_TAX_ENABLED=false
# Configure Stripe Dashboard > Settings > Billing > Customer portal before enabling production self-service.
STRIPE_CUSTOMER_PORTAL_ENABLED=false

# Stripe subscription Price IDs
# Create these prices in Stripe with the net monthly/yearly prices.
STRIPE_PRICE_STARTER_MONTHLY=price_replace_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_replace_starter_yearly
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_replace_professional_monthly
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_replace_professional_yearly
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_replace_enterprise_monthly
STRIPE_PRICE_ENTERPRISE_YEARLY=price_replace_enterprise_yearly

# Email for invoices and notifications
SENDGRID_API_KEY=SG_replace
SENDGRID_FROM_EMAIL=noreply@cargobit.eu
SENDGRID_FROM_NAME=CargoBit

# Maps
HERE_API_KEY=replace-with-here-api-key
