# CargoBit production environment template
# Copy to .env.production on the server. Never commit real values.

POSTGRES_USER=cargobit
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=cargobit
CARGOBIT_DOMAIN=cargobit.eu

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://cargobit.eu
NEXT_PUBLIC_URL=https://cargobit.eu
# Comma-separated frontend/admin origins allowed for browser API requests.
# Do not use * in production.
ALLOWED_ORIGINS=https://cargobit.eu,https://www.cargobit.eu
DATABASE_URL=postgresql://cargobit:replace-with-strong-db-password@postgres:5432/cargobit?schema=public
REDIS_URL=redis://redis:6379

ENCRYPTION_KEY=replace-with-long-random-secret
CRON_SECRET=replace-with-long-random-cron-secret
ADMIN_EMAIL=admin@cargobit.eu
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_JWT_SECRET=replace-with-long-random-jwt-secret
ADMIN_ROLE=ADMIN

LEGAL_REVIEW_CONFIRMED=false

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_replace_subscription
STRIPE_PAYOUT_WEBHOOK_SECRET=whsec_replace_payout
DEFAULT_STRIPE_ACCOUNT_ID=acct_replace
# Must stay false until Stripe Connect payouts are legally and technically configured.
STRIPE_PAYOUTS_ENABLED=false
STRIPE_PRICE_BUSINESS_MONTHLY=price_replace_business_monthly
STRIPE_TAX_ENABLED=false
STRIPE_CUSTOMER_PORTAL_ENABLED=false
ENABLE_LOCAL_MOCK_CHECKOUT=false

SENDGRID_API_KEY=SG_replace
SENDGRID_FROM_EMAIL=noreply@cargobit.eu
SENDGRID_FROM_NAME=CargoBit

MAP_PROVIDER=mock
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-with-browser-restricted-google-maps-key
GOOGLE_MAPS_SERVER_KEY=replace-with-server-restricted-google-maps-key
NEXT_PUBLIC_TRACKING_WS_URL=wss://cargobit.eu/ws
